{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowrun.dev/schemas/site.schema.json",
  "title": "flowrun site",
  "type": "object",
  "required": ["site_id", "name", "origins"],
  "additionalProperties": false,
  "properties": {
    "site_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": { "type": "string" },
    "aliases": {
      "type": "array",
      "items": { "type": "string" }
    },
    "origins": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "uri" }
    },
    "notes": { "type": "string" }
  }
}
